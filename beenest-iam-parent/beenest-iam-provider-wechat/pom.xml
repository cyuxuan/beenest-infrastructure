<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>club.beenest</groupId>
        <artifactId>beenest-iam-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>beenest-iam-provider-wechat</artifactId>
    <name>beenest-iam-provider-wechat</name>
    <description>第三方登录扩展包:微信(小程序登录与开放平台扫码登录)。打成交付 jar 后放进外置扩展包目录即可生效,不必改服务端依赖</description>

    <dependencies>
        <!-- 扩展包只依赖联邦运行时与核心 SPI,不触碰持久层。
             依赖一律 provided:它们由平台提供,不打进交付 jar,
             扩展包自身体积只剩自己的类与服务声明文件。 -->
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-federation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
