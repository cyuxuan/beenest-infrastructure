<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>club.beenest</groupId>
        <artifactId>beenest-iam-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>beenest-iam-web</artifactId>
    <name>beenest-iam-web</name>
    <description>协议页面与主题:登录/错误页,Thymeleaf 可插拔主题</description>

    <dependencies>
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-common</artifactId>
        </dependency>
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-core</artifactId>
        </dependency>
        <!-- 主题选择器读取 RealmContextHolder(请求期身份域上下文) -->
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-authz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 登录页需服务端渲染(CSRF token 必须内嵌),采用 Thymeleaf 轻量模板 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- 登录页控制器读取 CsrfToken -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
