# ===== 蜂巢 IAM 生产部署配置模板 =====
# 用法:
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   vi deploy/.env          # 逐项填入真实值
#   docker compose -f deploy/docker-compose.yaml --env-file deploy/.env up -d
#
# 约定:
#   1. 标【必填】的项没有安全默认值,留空时 compose 直接拒绝启动(不是跑起来才发现不对)
#   2. 标【按需】的项留空表示关闭对应能力,页面入口与接口都会明确报未启用
#   3. 本文件不得提交真实口令。deploy/.env 已在 .gitignore 中忽略
#   4. 口令类建议用 openssl rand -base64 32 生成,不要复用其它系统的口令


# ---------- 镜像 ----------
# 镜像仓库地址。【必填】改成实际仓库与命名空间
IAM_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/beenest-iam:1.0.0

# 部署对外暴露的业务端口
SERVER_PORT=8080

# 时区:审计与登录事件按应用时区落库,多实例必须统一
TZ=Asia/Shanghai


# ---------- 数据库 ----------
# PostgreSQL 连接串。【必填】
DB_URL=jdbc:postgresql://<db-host>:5432/beenest_iam
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# 连接池:并发 50 以内保持 20 即可,按 Prometheus 的 hikaricp_connections_pending 上调
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_LEAK_DETECTION_MS=60000
DB_STATEMENT_TIMEOUT_SECONDS=30


# ---------- Redis ----------
# 会话、授权状态、一次性票据都在 Redis,是强依赖而非缓存。【必填】
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_POOL_MAX_ACTIVE=32


# ---------- 安全核心 ----------
# 机密加密主密钥:保护域签名私钥、IdP 客户端密钥、LDAP/SMTP 口令。【必填】
# 生成:openssl rand -base64 32
# 换密钥前必须先用旧密钥把已落库的密文重新加密,否则旧密文解不开
IAM_REALM_KEY_SECRET=<openssl-rand-base64-32>

# 会话与 CSRF 令牌 Cookie 是否只走 HTTPS。
# 【最容易踩的一脚】用 http://IP:端口 直接访问时必须改成 false:
# 否则浏览器会丢弃带 Secure 的 SESSION 与 XSRF-TOKEN Cookie,登录提交时
# CSRF 令牌对不上,页面直接变成 403「页面出错了 / 无访问权限」。
# 判断方法:curl -D - http://<地址>/login | grep -i set-cookie,出现 Secure 就是踩了。
# 前置了反向代理并终结 TLS 时才用 true。
SESSION_COOKIE_SECURE=true

# 会话空闲超时兜底值;身份域策略会在登录时逐会话覆盖
SESSION_TIMEOUT=30m

# 对外基础地址:回调地址、邮件链接、SAML 元数据以它为前缀。
# 令牌签发方(iss)由请求域名生成,所以这里必须写用户实际访问的那个域名;
# 写成别名域名(或压根不存在的域名)会让令牌 iss 与验签基准不一致,接口一律 401
IAM_ISSUER_BASE_URL=https://<iam-domain>

# 跨源白名单:本站来源始终放行(只比主机名),此处只登记"页面部署在别的主机名上"的前端地址。
# 留空表示只接受本站请求
IAM_CORS_ALLOWED_ORIGINS=


# ---------- 引导管理员 ----------
# 仅首次初始化时生效;账号已存在则跳过创建
IAM_BOOTSTRAP_ENABLED=true
IAM_BOOTSTRAP_ADMIN_USERNAME=admin
# 平台不以任何默认口令启动:留空则不创建账号
IAM_BOOTSTRAP_ADMIN_PASSWORD=<首次登录后立即修改>


# ---------- Passkey / WebAuthn ----------
# 三项缺一不可:未启用或没配好依赖方标识与来源时,登录页不展示入口。
# rp-id 必须是 origin 的注册域或其父域,配错时认证器直接拒绝创建凭证
IAM_WEBAUTHN_ENABLED=false
IAM_WEBAUTHN_RP_ID=<iam-domain>
IAM_WEBAUTHN_ORIGIN=https://<iam-domain>
IAM_WEBAUTHN_RP_NAME=统一身份认证
IAM_WEBAUTHN_UV_REQUIRED=true
IAM_WEBAUTHN_ALLOW_USERNAMELESS=true
IAM_WEBAUTHN_TIMEOUT_MILLIS=60000
IAM_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
IAM_WEBAUTHN_MAX_CREDENTIALS=10


# ---------- 邮件通道 ----------
# channel 留空表示未启用:依赖邮件的入口在页面上不展示,接口明确报错
IAM_MAIL_CHANNEL=
IAM_MAIL_HOST=
IAM_MAIL_PORT=587
IAM_MAIL_USERNAME=
IAM_MAIL_PASSWORD=
IAM_MAIL_FROM=
IAM_MAIL_FROM_NAME=统一身份认证
IAM_MAIL_STARTTLS=true
IAM_MAIL_SSL=false
IAM_MAIL_TIMEOUT_MILLIS=10000


# ---------- 账户自助 ----------
IAM_PASSWORD_RESET_TTL_MINUTES=30
IAM_EMAIL_VERIFY_TTL_MINUTES=60


# ---------- 审计 ----------
# 合规要求至少保留 6 个月;<= 0 表示永久保留、不清理
IAM_AUDIT_RETENTION_DAYS=180
IAM_AUDIT_CLEANUP_CRON=0 30 3 * * *


# ---------- 外置扩展包 ----------
# 镜像内已带微信扩展包;追加第三方提供方时把 jar 挂到该目录
IAM_PROVIDER_DIR=/app/providers


# ---------- 运行参数 ----------
# 管理端口不对外发布,只供同网络内的采集器访问
MANAGEMENT_PORT=9090
IAM_LOG_LEVEL=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseZGC
