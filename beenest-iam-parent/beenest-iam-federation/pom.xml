<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>club.beenest</groupId>
        <artifactId>beenest-iam-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>beenest-iam-federation</artifactId>
    <name>beenest-iam-federation</name>
    <description>联邦运行时框架:Provider 注册表 + broker 流程 + 外部身份绑定 + OAuth2 基类(具体提供方在各扩展包)</description>

    <dependencies>
        <!-- 只依赖 core + common,便于微信/支付宝等 Provider 模块独立落入 -->
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-common</artifactId>
        </dependency>
        <dependency>
            <groupId>club.beenest</groupId>
            <artifactId>beenest-iam-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
